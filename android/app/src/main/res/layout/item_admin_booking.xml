<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_16"
    android:layout_marginEnd="@dimen/spacing_16"
    android:layout_marginBottom="@dimen/spacing_12"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/divider"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Header: Mã đơn + Trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdminBookingCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                tools:text="Mã đơn: #101" />
            <TextView
                android:id="@+id/tvAdminBookingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_image_placeholder"
                android:backgroundTint="@color/status_pending_bg"
                android:paddingStart="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_4"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingBottom="@dimen/spacing_4"
                android:textColor="@color/status_pending"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                tools:text="Chờ xác nhận" />
        </LinearLayout>

        <!-- Tên Homestay & Phòng -->
        <TextView
            android:id="@+id/tvAdminHomestayName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_title_medium"
            android:textStyle="bold"
            tools:text="An Nam Heritage Villa" />

        <TextView
            android:id="@+id/tvAdminRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body_medium"
            tools:text="Phòng Deluxe Phố Cổ • 2 khách" />

        <!-- Thông tin Khách hàng (User Info) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/bg_image_placeholder"
            android:backgroundTint="@color/surface_variant"
            android:orientation="vertical"
            android:padding="@dimen/spacing_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tvAdminCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_6"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold"
                    tools:text="Nguyễn Văn Khách" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAdminCustomerContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="@dimen/spacing_2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                tools:text="0912345678 • khach@gmail.com" />
        </LinearLayout>

        <!-- Ngày nhận/trả phòng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvAdminBookingDates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_6"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body_small"
                tools:text="15/11/2026 - 18/11/2026 (3 đêm)" />
        </LinearLayout>

        <!-- Đường kẻ ngăn cách nhẹ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/spacing_12"
            android:background="@color/divider" />

        <!-- Footer: Tổng tiền + Các nút thao tác Admin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng tiền:"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/tvAdminTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary"
                    android:textSize="@dimen/text_size_title_medium"
                    android:textStyle="bold"
                    tools:text="1.950.000 đ" />
            </LinearLayout>

            <!-- Nhóm nút bấm cho trạng thái PENDING -->
            <LinearLayout
                android:id="@+id/layoutAdminPendingActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminReject"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="@dimen/spacing_8"
                    android:paddingEnd="@dimen/spacing_8"
                    android:text="@string/admin_btn_reject"
                    android:textColor="@color/error"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/spacing_6"
                    app:strokeColor="@color/error"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminApprove"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/spacing_6"
                    android:backgroundTint="@color/primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="@dimen/spacing_8"
                    android:paddingEnd="@dimen/spacing_8"
                    android:text="@string/admin_btn_approve"
                    android:textColor="@color/on_primary"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/spacing_6" />
            </LinearLayout>

            <!-- Nhóm nút bấm cho trạng thái CONFIRMED -->
            <LinearLayout
                android:id="@+id/layoutAdminConfirmedActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminComplete"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/status_completed"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="@dimen/spacing_12"
                    android:paddingEnd="@dimen/spacing_12"
                    android:text="@string/admin_btn_complete"
                    android:textColor="@color/on_primary"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/spacing_6" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
