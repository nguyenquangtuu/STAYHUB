<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Profile Banner -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/primary">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/spacing_16"
                android:text="@string/profile_title"
                android:textColor="@color/on_primary"
                android:textSize="@dimen/text_size_headline_small"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Thẻ thông tin cá nhân nổi bật -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="@dimen/spacing_16"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_24">

                <!-- Avatar giả lập -->
                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="@dimen/avatar_size_large"
                    android:layout_height="@dimen/avatar_size_large"
                    android:background="@drawable/bg_image_placeholder"
                    android:backgroundTint="@color/primary_container"
                    android:contentDescription="@string/profile_title"
                    android:padding="@dimen/spacing_16"
                    android:src="@drawable/ic_person"
                    app:tint="@color/primary" />

                <!-- Tên người dùng -->
                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_title_large"
                    android:textStyle="bold"
                    tools:text="Nguyễn Văn Khách" />

                <!-- Role badge -->
                <TextView
                    android:id="@+id/tvProfileRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_6"
                    android:background="@drawable/bg_image_placeholder"
                    android:backgroundTint="@color/secondary_container"
                    android:paddingStart="@dimen/spacing_12"
                    android:paddingTop="@dimen/spacing_4"
                    android:paddingEnd="@dimen/spacing_12"
                    android:paddingBottom="@dimen/spacing_4"
                    android:textColor="@color/on_secondary_container"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"
                    tools:text="Khách hàng" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Thẻ chi tiết liên hệ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_marginEnd="@dimen/spacing_16"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_16">

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_email"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_large"
                    tools:text="khachhang1@gmail.com" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:layout_marginBottom="@dimen/spacing_12"
                    android:background="@color/divider" />

                <!-- Số điện thoại -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_phone"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/tvProfilePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_large"
                    tools:text="0912345678" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nút Đăng xuất -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginTop="@dimen/spacing_32"
            android:layout_marginEnd="@dimen/spacing_16"
            android:layout_marginBottom="@dimen/spacing_32"
            android:text="@string/btn_logout"
            android:textColor="@color/error"
            android:textSize="@dimen/text_size_body_large"
            app:cornerRadius="@dimen/spacing_8"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconTint="@color/error"
            app:strokeColor="@color/error" />

    </LinearLayout>

</ScrollView>

