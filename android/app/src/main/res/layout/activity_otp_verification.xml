<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/primary"
            app:title="@string/otp_title"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_24">

            <!-- Icon minh họa -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="@dimen/spacing_16"
                android:background="@drawable/bg_image_placeholder"
                android:backgroundTint="@color/primary_container"
                android:contentDescription="@string/otp_title"
                android:padding="@dimen/spacing_16"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tvOtpSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body_large"
                tools:text="Mã OTP gồm 6 chữ số đã được gửi đến 0912345678" />

            <!-- Thẻ gợi ý mã OTP mẫu (rất thuận tiện cho giảng viên / kiểm thử viên) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMockOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                app:cardBackgroundColor="@color/secondary_container"
                app:cardCornerRadius="@dimen/spacing_8"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_12">

                    <TextView
                        android:id="@+id/tvMockOtpHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💡 Mã OTP thử nghiệm: 123456"
                        android:textColor="@color/on_secondary_container"
                        android:textSize="@dimen/text_size_body_medium"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickFillOtp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Điền nhanh"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body_small" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6 ô gạch dưới nhập mã OTP hiện đại -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_32">

                <!-- 6 ô hiển thị số và gạch dưới -->
                <LinearLayout
                    android:id="@+id/layoutOtpSlots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOtp1"
                        android:layout_width="48dp"
                        android:layout_height="58dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_otp_slot_focused"
                        android:gravity="center"
                        android:textColor="@color/primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="1" />

                    <TextView
                        android:id="@+id/tvOtp2"
                        android:layout_width="48dp"
                        android:layout_height="58dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_otp_slot_inactive"
                        android:gravity="center"
                        android:textColor="@color/primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="2" />

                    <TextView
                        android:id="@+id/tvOtp3"
                        android:layout_width="48dp"
                        android:layout_height="58dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_otp_slot_inactive"
                        android:gravity="center"
                        android:textColor="@color/primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="3" />

                    <TextView
                        android:id="@+id/tvOtp4"
                        android:layout_width="48dp"
                        android:layout_height="58dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_otp_slot_inactive"
                        android:gravity="center"
                        android:textColor="@color/primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="4" />

                    <TextView
                        android:id="@+id/tvOtp5"
                        android:layout_width="48dp"
                        android:layout_height="58dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_otp_slot_inactive"
                        android:gravity="center"
                        android:textColor="@color/primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="5" />

                    <TextView
                        android:id="@+id/tvOtp6"
                        android:layout_width="48dp"
                        android:layout_height="58dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_otp_slot_inactive"
                        android:gravity="center"
                        android:textColor="@color/primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="6" />

                </LinearLayout>

                <!-- EditText ẩn phủ lên để nhận bàn phím và paste -->
                <EditText
                    android:id="@+id/etHiddenOtp"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:background="@android:color/transparent"
                    android:cursorVisible="false"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textColor="@android:color/transparent" />

            </FrameLayout>

            <!-- Báo lỗi nếu mã OTP không hợp lệ -->
            <TextView
                android:id="@+id/tvOtpError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:textColor="@color/error"
                android:textSize="@dimen/text_size_caption"
                android:visibility="gone"
                tools:text="Mã OTP phải gồm đúng 6 chữ số"
                tools:visibility="visible" />

            <!-- Nút Xác thực -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerify"
                    style="@style/Widget.StayHub.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/btn_verify_otp"
                    android:textSize="@dimen/text_size_body_large" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/on_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Nút Gửi lại mã -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResendOtp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/btn_resend_otp"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_body_medium" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

