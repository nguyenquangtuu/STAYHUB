<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_16"
    android:layout_marginEnd="@dimen/spacing_16"
    android:layout_marginBottom="@dimen/spacing_12"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/spacing_12"
    app:cardElevation="2dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Header: Room Name + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAdminRoomName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_title_medium"
                android:textStyle="bold"
                tools:text="Phòng Deluxe Hướng Núi" />

            <TextView
                android:id="@+id/tvAdminRoomStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_image_placeholder"
                android:backgroundTint="@color/status_completed_bg"
                android:textColor="@color/status_completed"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_4"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingBottom="@dimen/spacing_4"
                tools:text="Sẵn sàng" />
        </LinearLayout>

        <!-- Room Specs: Capacity, Bed Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdminRoomCapacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body_small"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="@dimen/spacing_4"
                tools:text="2 khách" />

            <TextView
                android:id="@+id/tvAdminRoomBed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_16"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body_small"
                android:drawableStart="@drawable/ic_hotel"
                android:drawablePadding="@dimen/spacing_4"
                tools:text="1 Giường đôi lớn" />
        </LinearLayout>

        <!-- Price -->
        <TextView
            android:id="@+id/tvAdminRoomPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_title_medium"
            android:textStyle="bold"
            tools:text="750.000 đ / đêm" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/spacing_12"
            android:background="@color/divider" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditRoom"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_8"
                android:text="Chỉnh sửa"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:cornerRadius="@dimen/spacing_8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteRoom"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xóa phòng"
                android:textColor="@color/error"
                app:cornerRadius="@dimen/spacing_8" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
