<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_20">

        <TextView
            android:id="@+id/tvDialogRoomTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm Phòng Nghỉ Mới"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_title_large"
            android:textStyle="bold" />

        <!-- Tên phòng -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoomName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:hint="Tên phòng *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoomName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Giá mỗi đêm -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoomPrice"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="Giá mỗi đêm (VNĐ) *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoomPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sức chứa khách -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoomCapacity"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="Sức chứa tối đa (người) *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoomCapacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Loại giường -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoomBedType"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="Loại giường (ví dụ: 1 Giường đôi lớn, 2 Giường đơn) *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoomBedType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Trạng thái phòng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="Trạng thái phòng"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />

        <Spinner
            android:id="@+id/spinnerRoomStatus"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/spacing_4" />

        <!-- Nút hành động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelRoom"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_8"
                android:text="Hủy"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveRoom"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:text="Lưu lại"
                android:textColor="@color/on_primary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
