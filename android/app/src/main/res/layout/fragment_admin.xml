<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Nội dung chính màn hình Quản trị -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header & Action Bar của Admin -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:elevation="3dp"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_16"
                android:paddingTop="@dimen/spacing_12"
                android:paddingEnd="@dimen/spacing_16"
                android:paddingBottom="@dimen/spacing_8">

                <!-- Top Row: Icon Menu Hamburger + Tiêu đề Phân hệ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Nút mở Menu Trượt Bên Trái -->
                    <ImageView
                        android:id="@+id/btnOpenAdminMenu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Mở menu quản trị"
                        android:padding="8dp"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAdminSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quản lý Đơn đặt phòng"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_size_title_large"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAdminSectionSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_subtitle"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Container Thống kê & Lọc cho Đơn đặt (Booking Stats & Filters) -->
                <LinearLayout
                    android:id="@+id/layoutBookingStatsAndFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- 3 Thẻ thống kê tổng quan (Admin Stats) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Card 1: Tổng đơn -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_4"
                            app:cardBackgroundColor="@color/primary_container"
                            app:cardCornerRadius="@dimen/spacing_8"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_8">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/admin_stat_total"
                                    android:textColor="@color/on_primary_container"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvStatTotalBookings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_2"
                                    android:textColor="@color/primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="12" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Card 2: Chờ duyệt (Pending) -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_4"
                            android:layout_marginEnd="@dimen/spacing_4"
                            app:cardBackgroundColor="@color/status_pending_bg"
                            app:cardCornerRadius="@dimen/spacing_8"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_8">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/admin_stat_pending"
                                    android:textColor="@color/status_pending"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvStatPendingBookings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_2"
                                    android:textColor="@color/status_pending"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="3" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Card 3: Doanh thu (Revenue) -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:layout_marginStart="@dimen/spacing_4"
                            app:cardBackgroundColor="@color/status_completed_bg"
                            app:cardCornerRadius="@dimen/spacing_8"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_8">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/admin_stat_revenue"
                                    android:textColor="@color/status_completed"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvStatRevenue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_2"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/status_completed"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="14.2M đ" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- TabLayout Bộ lọc trạng thái đơn booking -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayoutAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:background="@android:color/transparent"
                        app:tabIndicatorColor="@color/primary"
                        app:tabIndicatorHeight="3dp"
                        app:tabMode="scrollable"
                        app:tabSelectedTextColor="@color/primary"
                        app:tabTextAppearance="@style/TextAppearance.Material3.LabelMedium"
                        app:tabTextColor="@color/text_secondary">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_filter_all" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_filter_pending" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_filter_confirmed" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_filter_completed" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_filter_cancelled" />
                    </com.google.android.material.tabs.TabLayout>
                </LinearLayout>

                <!-- Container Chọn Chi nhánh (dành cho Phòng và Đánh giá) -->
                <LinearLayout
                    android:id="@+id/layoutHomestaySelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_select_homestay_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body_small"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerAdminHomestay"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>

            <!-- Content: SwipeRefreshLayout + 4 RecyclerViews -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshAdmin"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- 1. Danh sách đơn đặt phòng -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAdminBookings"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_16"
                        tools:listitem="@layout/item_admin_booking" />

                    <!-- 2. Danh sách Quản lý Chi nhánh -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAdminHomestays"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_80"
                        android:visibility="gone"
                        tools:listitem="@layout/item_admin_homestay" />

                    <!-- 3. Danh sách Quản lý Phòng -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAdminRooms"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_80"
                        android:visibility="gone"
                        tools:listitem="@layout/item_admin_room" />

                    <!-- 4. Danh sách Quản lý Đánh giá -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAdminReviews"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_16"
                        android:visibility="gone"
                        tools:listitem="@layout/item_admin_review" />

                    <!-- Trạng thái trống (Empty State) -->
                    <LinearLayout
                        android:id="@+id/layoutAdminEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_24"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivAdminEmptyIcon"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:id="@+id/tvAdminEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_12"
                            android:text="@string/admin_empty_bookings"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_body_medium" />
                    </LinearLayout>

                    <!-- Loading Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone" />

                </FrameLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

        <!-- Nút Floating Thêm mới (Chi nhánh / Phòng) -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabAdminAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/spacing_16"
            android:layout_marginBottom="@dimen/spacing_16"
            android:backgroundTint="@color/primary"
            android:text="@string/admin_btn_add_homestay"
            android:textColor="@color/on_primary"
            app:icon="@drawable/ic_edit"
            app:iconTint="@color/on_primary"
            android:visibility="gone" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 2. Menu Bên Trái (Side Navigation Drawer của riêng màn Quản trị) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/adminNavigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        app:headerLayout="@layout/nav_header_admin"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/menu_admin_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
