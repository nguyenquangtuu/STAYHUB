<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/primary"
            app:title="@string/booking_title"
            app:titleTextColor="@color/primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- Thẻ tóm tắt thông tin phòng đã chọn -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:id="@+id/tvBookingHomestayName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_title_medium"
                        android:textStyle="bold"
                        tools:text="An Nam Heritage Villa" />

                    <TextView
                        android:id="@+id/tvBookingRoomName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body_large"
                        tools:text="Phòng Deluxe Phố Cổ" />

                    <TextView
                        android:id="@+id/tvPricePerNight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:textColor="@color/secondary"
                        android:textSize="@dimen/text_size_body_medium"
                        android:textStyle="bold"
                        tools:text="650.000 ₫ / đêm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chọn Ngày nhận phòng (Check-in) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCheckIn"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:hint="@string/label_check_in"
                app:boxStrokeColor="@color/primary"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom"
                app:endIconTint="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCheckIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_medium" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Chọn Ngày trả phòng (Check-out) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCheckOut"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:hint="@string/label_check_out"
                app:boxStrokeColor="@color/primary"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom"
                app:endIconTint="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCheckOut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_medium" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Trạng thái phòng trống (Availability Banner) -->
            <LinearLayout
                android:id="@+id/layoutAvailabilityStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:background="@drawable/bg_image_placeholder"
                android:backgroundTint="@color/surface_variant"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_12"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/imgAvailabilityIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle" />

                <TextView
                    android:id="@+id/tvAvailabilityStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold"
                    tools:text="Phòng còn trống và sẵn sàng phục vụ" />

                <ProgressBar
                    android:id="@+id/progressAvailability"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/primary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Số lượng khách (Bộ tăng giảm +/- tiện lợi) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingTop="@dimen/spacing_12"
                    android:paddingEnd="@dimen/spacing_16"
                    android:paddingBottom="@dimen/spacing_12">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_guests"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvGuestCapacityHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tối đa 2 khách"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_size_caption" />
                    </LinearLayout>

                    <!-- Bộ điều khiển tăng giảm +/- -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDecreaseGuests"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="Giảm số khách"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            app:icon="@drawable/ic_minus"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@color/primary" />

                        <TextView
                            android:id="@+id/tvGuestCount"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_title_medium"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIncreaseGuests"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="Tăng số khách"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            app:icon="@drawable/ic_plus"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@color/primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ghi chú đặc biệt -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNote"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:hint="@string/label_note"
                app:boxStrokeColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_medium" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bảng tính tiền tổng cộng -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thời gian lưu trú"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_body_medium" />

                        <TextView
                            android:id="@+id/tvNightsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_medium"
                            tools:text="1 đêm" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:layout_marginBottom="@dimen/spacing_12"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_price_label"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body_large"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTotalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/secondary"
                            android:textSize="@dimen/text_size_title_large"
                            android:textStyle="bold"
                            tools:text="650.000 ₫" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nút Xác nhận đặt phòng -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:layout_marginBottom="@dimen/spacing_32">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmBooking"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/btn_confirm_booking"
                    android:textSize="@dimen/text_size_body_large"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="@dimen/spacing_8" />

                <ProgressBar
                    android:id="@+id/progressBarBooking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/on_primary"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

