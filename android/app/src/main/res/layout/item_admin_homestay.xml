<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_16"
    android:layout_marginEnd="@dimen/spacing_16"
    android:layout_marginBottom="@dimen/spacing_12"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/spacing_12"
    app:cardElevation="2dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Header: ID + Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHomestayId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                tools:text="ID #1" />

            <TextView
                android:id="@+id/tvHomestayRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rating_star"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_star"
                android:drawablePadding="@dimen/spacing_4"
                tools:text="4.8" />
        </LinearLayout>

        <!-- Body: Photo Thumbnail + Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHomestayThumb"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginEnd="@dimen/spacing_12"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                android:src="@drawable/bg_image_placeholder"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHomestayName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_title_medium"
                    android:textStyle="bold"
                    tools:text="Da Lat Pine Hill Homestay" />

                <TextView
                    android:id="@+id/tvHomestayLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_small"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="@dimen/spacing_4"
                    tools:text="Phường 3, TP. Đà Lạt" />

                <TextView
                    android:id="@+id/tvHomestayDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_caption"
                    tools:text="Không gian yên tĩnh giữa rừng thông, view đồi núi cực đẹp..." />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/spacing_12"
            android:background="@color/divider" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditHomestay"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_8"
                android:text="Chỉnh sửa"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:cornerRadius="@dimen/spacing_8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteHomestay"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xóa"
                android:textColor="@color/error"
                app:cornerRadius="@dimen/spacing_8" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
