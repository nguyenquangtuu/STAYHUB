<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_20">

        <TextView
            android:id="@+id/tvDialogHomestayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm Homestay Mới"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_title_large"
            android:textStyle="bold" />

        <!-- Tên Homestay -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHomestayName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:hint="Tên Homestay *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHomestayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Thành phố -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHomestayCity"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="Thành phố / Tỉnh thành *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHomestayCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Địa chỉ chi tiết -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHomestayAddress"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="Địa chỉ chi tiết *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHomestayAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Mô tả -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHomestayDescription"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="Mô tả Homestay">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHomestayDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:lines="3"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tiện nghi -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHomestayAmenities"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="Tiện nghi (phân cách bởi dấu phẩy, vd: wifi, pool, bbq)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHomestayAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nút hành động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelHomestay"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_8"
                android:text="Hủy"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveHomestay"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:text="Lưu lại"
                android:textColor="@color/on_primary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
