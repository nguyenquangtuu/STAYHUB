<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme: Material3 DayNight -->
    <style name="Theme.StayHub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary (Accent) Colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOutline">@color/outline</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <!-- Component Shape Appearances -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.StayHub.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.StayHub.LargeComponent</item>
        <item name="materialCardViewStyle">@style/Widget.StayHub.CardView</item>
    </style>

    <!-- Card Shape & Style (12dp corner radius & 2dp elevation) -->
    <style name="ShapeAppearance.StayHub.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

    <style name="ShapeAppearance.StayHub.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

    <style name="Widget.StayHub.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
    </style>

    <!-- Outlined Button Style -->
    <style name="Widget.StayHub.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/spacing_8</item>
        <item name="strokeColor">@color/primary</item>
    </style>
</resources>

