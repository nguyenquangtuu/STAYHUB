<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quyền truy cập mạng Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".StayHubApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.StayHub"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <!-- Splash Screen (Màn hình khởi động kiểm tra phiên đăng nhập) -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.StayHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Đăng nhập -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Đăng ký -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình chính (Bottom Navigation Host: Home | Bookings | Profile) -->
        <activity
            android:name=".ui.home.MainActivity"
            android:exported="false" />

        <!-- Chi tiết Homestay -->
        <activity
            android:name=".ui.homestay.HomestayDetailActivity"
            android:exported="false" />

        <!-- Đặt phòng -->
        <activity
            android:name=".ui.booking.BookingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Đánh giá Homestay -->
        <activity
            android:name=".ui.review.WriteReviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>

